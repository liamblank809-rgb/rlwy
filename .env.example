# ===== REQUIRED =====
OPENROUTER_API_KEY=

# Your final public HTTPS Railway/custom-domain URL.
PAPERCLIP_AUTH_PUBLIC_BASE_URL=https://YOUR-RAILWAY-DOMAIN

# ===== MODEL =====
FOUNDER_MODEL=anthropic/claude-sonnet-4.6

# ===== PAPERCLIP =====
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=public
PAPERCLIP_ALLOWED_HOSTNAMES=

# ===== OPTIONAL DIRECT PROVIDERS =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Do not set API_SERVER_KEY unless you specifically want to manage the
# Hermes gateway credential yourself. Otherwise the container generates
# and persists a random credential under /data/hermes/.gateway-key.
